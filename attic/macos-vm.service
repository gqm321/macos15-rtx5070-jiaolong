[Unit]
Description=macOS 15 VM (RTX 5070 passthrough, MUX to dGPU)
# 只有 GRUB 里「macOS VM」那个启动项才生效（普通启动完全不碰）
ConditionKernelCommandLine=macosvm=1
After=local-fs.target systemd-user-sessions.service

[Service]
Type=forking
PIDFile=/home/guqiaomu/vm-macos-qemu/dump/mac.pid
# 清掉上次的启动标记：ExecStart 失败时 ExecStopPost 看到「没有标记」就不会关宿主，
# 避免「VM 起不来 → 宿主关机 → 开机 → 又起不来」的死循环。
ExecStartPre=/bin/rm -f /home/guqiaomu/vm-macos-qemu/dump/vm-started-at
# BAR1 必须是 4 GiB：8 GiB 会让客机卡在 "PCI configuration" 把宿主拖死
ExecStartPre=/home/guqiaomu/vm-macos-qemu/tools/bar1-boot.sh
# 以桌面用户身份起，串口日志/socket 的属主才是 guqiaomu
ExecStart=/usr/bin/setpriv --reuid=guqiaomu --regid=guqiaomu --init-groups /bin/bash -c 'cd /home/guqiaomu/vm-macos-qemu && exec bash start-mac15.sh'
# 正常起来后打时间戳，ExecStopPost 用它区分「跑过一阵才退出」和「启动就崩」
ExecStartPost=/bin/sh -c 'rm -f /run/macosvm-stopping; date +%s > /home/guqiaomu/vm-macos-qemu/dump/vm-started-at; chown guqiaomu:guqiaomu /home/guqiaomu/vm-macos-qemu/dump/vm-started-at'
ExecStop=/home/guqiaomu/vm-macos-qemu/tools/vm-stop.sh
# 关键：VM 自己退出（客机里关机）→ 关宿主；主动停止不关。
# 不用 RemainAfterExit，否则 QEMU 退了 systemd 也不知道，ExecStopPost 不会跑。
ExecStopPost=/home/guqiaomu/vm-macos-qemu/tools/vm-poweroff-maybe.sh
TimeoutStopSec=200

[Install]
WantedBy=multi-user.target
